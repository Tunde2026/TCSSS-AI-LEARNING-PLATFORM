  flex-wrap: wrap;
  border-top: 1px solid var(--border-soft);
  padding-top: 10px;
}
.admin-bar__link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: 8px;
  font-family: var(--font-body);
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--slate);
  text-decoration: none;
  transition: background var(--transition), color var(--transition);
  white-space: nowrap;
}
.admin-bar__link:hover {
  background: var(--blush);
  color: var(--navy);
  text-decoration: none;
}
.admin-bar__link.is-active {
  background: var(--navy);
  color: var(--white);
}
.admin-bar__link i { font-size: 0.8rem; }

/* Branding section on settings page */
.branding-preview {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 20px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.branding-preview__box {
  width: 80px;
  height: 80px;
  border-radius: 14px;
  background: var(--blush);
  display: grid;
  place-items: center;
  overflow: hidden;
  flex-shrink: 0;
  border: 1px dashed var(--border);
}
.branding-preview__box img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 8px;
}
.branding-preview__box span {
  font-family: var(--font-ui);
  font-size: 0.7rem;
  color: var(--slate);
  letter-spacing: 0.08em;
}
.branding-preview__body { flex: 1; min-width: 0; }
.branding-preview__title {
  font-weight: 600;
  color: var(--ink);
  font-size: 0.95rem;
  margin: 0 0 4px;
}
.branding-preview__hint {
  font-size: 0.8rem;
  color: var(--slate);
  margin: 0 0 12px;
  line-height: 1.5;
}
.branding-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

@media (max-width: 640px) {
  .admin-bar { padding: 10px; }
  .admin-bar__link { padding: 7px 10px; font-size: 0.8rem; }
  .admin-bar__link span { display: none; }
  .admin-bar__link i { font-size: 1rem; }
  .branding-preview { flex-direction: column; align-items: flex-start; text-align: left; }
}

