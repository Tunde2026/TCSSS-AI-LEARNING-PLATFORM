/* ============================================================
   Floating "Ask AI" button + panel
   ============================================================ */

#ask-ai-fab {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 90;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 20px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--navy), var(--soft-navy));
  color: var(--white);
  border: none;
  font-family: var(--font-body);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(17,16,74,0.28), 0 2px 6px rgba(17,16,74,0.15);
  transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
}
#ask-ai-fab:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 12px 32px rgba(17,16,74,0.35), 0 4px 10px rgba(17,16,74,0.2);
}
#ask-ai-fab:active { transform: translateY(0) scale(0.98); }
#ask-ai-fab i { font-size: 0.95rem; color: var(--gold-300); }
#ask-ai-fab.is-hidden { opacity: 0; pointer-events: none; transform: translateY(20px); }

#ask-ai-panel {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 95;
  width: 400px;
  max-width: calc(100vw - 32px);
  height: 560px;
  max-height: calc(100vh - 48px);
  background: var(--white);
  border-radius: 20px;
  box-shadow: 0 24px 60px rgba(17,16,74,0.28), 0 8px 20px rgba(17,16,74,0.12);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  opacity: 0;
  transform: translateY(16px) scale(0.98);
  pointer-events: none;
  transition: opacity 260ms var(--ease-out), transform 260ms var(--ease-out);
  border: 1px solid var(--border);
}
#ask-ai-panel.is-open {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.ask-ai__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  background: linear-gradient(135deg, var(--navy), var(--soft-navy));
  color: var(--white);
  flex-shrink: 0;
}
.ask-ai__title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-head);
  font-weight: 600;
  font-size: 0.98rem;
}
.ask-ai__title i { color: var(--gold-300); font-size: 0.95rem; }
.ask-ai__title small {
  display: block;
  font-family: var(--font-ui);
  font-size: 0.6rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.7;
  font-weight: 400;
  margin-left: 6px;
}
.ask-ai__head-actions { display: flex; gap: 4px; }
.ask-ai__head-actions button {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background: transparent;
  border: none;
  color: rgba(255,255,255,0.8);
  cursor: pointer;
  display: grid;
  place-items: center;
  font-size: 0.85rem;
  transition: background var(--transition);
}
.ask-ai__head-actions button:hover { background: rgba(255,255,255,0.12); color: var(--white); }

.ask-ai__body {
  flex: 1;
  overflow-y: auto;
  padding: 18px 18px 4px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: var(--blush);
}
.ask-ai__body::-webkit-scrollbar { width: 6px; }
.ask-ai__body::-webkit-scrollbar-thumb { background: rgba(17,16,74,0.15); border-radius: 3px; }

.ask-ai__empty {
  text-align: center;
  padding: 30px 14px;
  color: var(--slate);
}
.ask-ai__empty-icon {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  background: linear-gradient(135deg, var(--gold-50), #FEF8E7);
  color: var(--gold);
  display: grid;
  place-items: center;
  margin: 0 auto 14px;
  font-size: 1.3rem;
}
.ask-ai__empty p { margin: 0 0 8px; font-size: 0.9rem; line-height: 1.5; }
.ask-ai__empty p strong { color: var(--navy); font-size: 1.05rem; }
.ask-ai__suggest {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 14px;
}
.ask-ai__suggest button {
  padding: 7px 12px;
  border-radius: 999px;
  border: 1.5px solid var(--border);
  background: var(--white);
  color: var(--slate);
  font-family: var(--font-body);
  font-size: 0.78rem;
  font-weight: 500;
  cursor: pointer;
  transition: background var(--transition), border-color var(--transition), color var(--transition);
}
.ask-ai__suggest button:hover {
  border-color: var(--navy);
  color: var(--navy);
  background: var(--blush);
}

.ask-ai__msg {
  max-width: 88%;
  padding: 10px 14px;
  border-radius: 14px;
  font-size: 0.88rem;
  line-height: 1.55;
  white-space: pre-wrap;
  word-wrap: break-word;
}
.ask-ai__msg--user {
  align-self: flex-end;
  background: var(--navy);
  color: var(--white);
  border-bottom-right-radius: 4px;
}
.ask-ai__msg--ai {
  align-self: flex-start;
  background: var(--white);
  color: var(--ink);
  border: 1px solid var(--border);
  border-bottom-left-radius: 4px;
  box-shadow: var(--shadow-xs);
}

.ask-ai__dots {
  display: inline-flex;
  gap: 4px;
  align-items: center;
}
.ask-ai__dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--slate-300);
  animation: ask-ai-bounce 1.2s infinite ease-in-out;
}
.ask-ai__dots span:nth-child(2) { animation-delay: 0.15s; }
.ask-ai__dots span:nth-child(3) { animation-delay: 0.3s; }
@keyframes ask-ai-bounce {
  0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-3px); }
}

.ask-ai__form {
  display: flex;
  gap: 8px;
  align-items: flex-end;
  padding: 12px 14px;
  border-top: 1px solid var(--border-soft);
  background: var(--white);
  flex-shrink: 0;
}
.ask-ai__form textarea {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  resize: none;
  font-family: var(--font-body);
  font-size: 0.9rem;
  line-height: 1.5;
  max-height: 120px;
  padding: 8px 4px;
  color: var(--ink);
  min-height: 20px;
}
.ask-ai__form textarea::placeholder { color: var(--slate-300); }
.ask-ai__form button {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--red);
  color: var(--white);
  border: none;
  cursor: pointer;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  font-size: 0.85rem;
  transition: background var(--transition), transform var(--transition);
}
.ask-ai__form button:hover:not(:disabled) {
  background: var(--deep-red);
  transform: scale(1.05);
}
.ask-ai__form button:disabled { background: var(--slate-300); cursor: not-allowed; }

@media (max-width: 640px) {
  #ask-ai-fab { bottom: 16px; right: 16px; padding: 11px 16px; font-size: 0.85rem; }
  #ask-ai-panel { bottom: 0; right: 0; left: 0; width: 100%; height: 100vh; max-width: none; max-height: none; border-radius: 0; }
}

@media (prefers-reduced-motion: reduce) {
  #ask-ai-fab, #ask-ai-panel { transition: none !important; }
}

/* ============================================================
   Wider content area on Studying Lab pages
   Removes the empty right-hand gap on desktop.
   ============================================================ */

body:has(.lab-bar) .page-inner,
body:has(.lab-bar) .viz-inner,
body:has(.lab-bar) .fc-inner,
body:has(.lab-bar) .pr-inner,
body:has(.lab-bar) .sp-inner,
body:has(.lab-bar) .qh-inner,
body:has(.lab-bar) .exam-inner {
  max-width: 1440px;
}

/* Also widen the tool grid on lab.html so cards stretch evenly */
body:has(.lab-bar) .tool-grid,
.tool-grid {
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
}
/* ---------- Sidebar support link ---------- */
.nav-item--support {
  position: relative;
  color: rgba(255, 255, 255, 0.82) !important;
}

.nav-item--support:hover {
  color: #FFFFFF !important;
  background: rgba(230, 17, 30, 0.15) !important;
}

.nav-item--support i {
  color: var(--gold) !important;
}

.nav-item__badge {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  border-radius: 999px;
  background: var(--red);
  color: #FFFFFF;
  font-family: var(--font-ui);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(230, 17, 30, 0.4);
}
/* ---------- Admin bar support badge ---------- */
.admin-bar__badge-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 18px;
  height: 18px;
  padding: 0 6px;
  margin-left: 6px;
  border-radius: 999px;
  background: var(--red);
  color: #FFFFFF;
  font-family: var(--font-ui);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  box-shadow: 0 2px 6px rgba(230, 17, 30, 0.4);
  flex-shrink: 0;
  vertical-align: middle;
}