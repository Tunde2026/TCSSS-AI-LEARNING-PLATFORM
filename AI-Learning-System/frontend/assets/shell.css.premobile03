/* ============================================================
   Floating "Ask AI" button + panel
   ============================================================ */

#ask-ai-fab {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 90;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 20px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--navy), var(--soft-navy));
  color: var(--white);
  border: none;
  font-family: var(--font-body);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(17,16,74,0.28), 0 2px 6px rgba(17,16,74,0.15);
  transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
}
#ask-ai-fab:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 12px 32px rgba(17,16,74,0.35), 0 4px 10px rgba(17,16,74,0.2);
}
#ask-ai-fab:active { transform: translateY(0) scale(0.98); }
#ask-ai-fab i { font-size: 0.95rem; color: var(--gold-300); }
#ask-ai-fab.is-hidden { opacity: 0; pointer-events: none; transform: translateY(20px); }

#ask-ai-panel {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 95;
  width: 400px;
  max-width: calc(100vw - 32px);
  height: 560px;
  max-height: calc(100vh - 48px);
  background: var(--white);
  border-radius: 20px;
  box-shadow: 0 24px 60px rgba(17,16,74,0.28), 0 8px 20px rgba(17,16,74,0.12);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  opacity: 0;
  transform: translateY(16px) scale(0.98);
  pointer-events: none;
  transition: opacity 260ms var(--ease-out), transform 260ms var(--ease-out);
  border: 1px solid var(--border);
}
#ask-ai-panel.is-open {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.ask-ai__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  background: linear-gradient(135deg, var(--navy), var(--soft-navy));
  color: var(--white);
  flex-shrink: 0;
}
.ask-ai__title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-head);
  font-weight: 600;
  font-size: 0.98rem;
}
.ask-ai__title i { color: var(--gold-300); font-size: 0.95rem; }
.ask-ai__title small {
  display: block;
  font-family: var(--font-ui);
  font-size: 0.6rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.7;
  font-weight: 400;
  margin-left: 6px;
}
.ask-ai__head-actions { display: flex; gap: 4px; }
.ask-ai__head-actions button {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background: transparent;
  border: none;
  color: rgba(255,255,255,0.8);
  cursor: pointer;
  display: grid;
  place-items: center;
  font-size: 0.85rem;
  transition: background var(--transition);
}
.ask-ai__head-actions button:hover { background: rgba(255,255,255,0.12); color: var(--white); }

.ask-ai__body {
  flex: 1;
  overflow-y: auto;
  padding: 18px 18px 4px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: var(--blush);
}
.ask-ai__body::-webkit-scrollbar { width: 6px; }
.ask-ai__body::-webkit-scrollbar-thumb { background: rgba(17,16,74,0.15); border-radius: 3px; }

.ask-ai__empty {
  text-align: center;
  padding: 30px 14px;
  color: var(--slate);
}
.ask-ai__empty-icon {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  background: linear-gradient(135deg, var(--gold-50), #FEF8E7);
  color: var(--gold);
  display: grid;
  place-items: center;
  margin: 0 auto 14px;
  font-size: 1.3rem;
}
.ask-ai__empty p { margin: 0 0 8px; font-size: 0.9rem; line-height: 1.5; }
.ask-ai__empty p strong { color: var(--navy); font-size: 1.05rem; }
.ask-ai__suggest {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 14px;
}
.ask-ai__suggest button {
  padding: 7px 12px;
  border-radius: 999px;
  border: 1.5px solid var(--border);
  background: var(--white);
  color: var(--slate);
  font-family: var(--font-body);
  font-size: 0.78rem;
  font-weight: 500;
  cursor: pointer;
  transition: background var(--transition), border-color var(--transition), color var(--transition);
}
.ask-ai__suggest button:hover {
  border-color: var(--navy);
  color: var(--navy);
  background: var(--blush);
}

.ask-ai__msg {
  max-width: 88%;
  padding: 10px 14px;
  border-radius: 14px;
  font-size: 0.88rem;
  line-height: 1.55;
  white-space: pre-wrap;
  word-wrap: break-word;
}
.ask-ai__msg--user {
  align-self: flex-end;
  background: var(--navy);
  color: var(--white);
  border-bottom-right-radius: 4px;
}
.ask-ai__msg--ai {
  align-self: flex-start;
  background: var(--white);
  color: var(--ink);
  border: 1px solid var(--border);
  border-bottom-left-radius: 4px;
  box-shadow: var(--shadow-xs);
}

.ask-ai__dots {
  display: inline-flex;
  gap: 4px;
  align-items: center;
}
.ask-ai__dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--slate-300);
  animation: ask-ai-bounce 1.2s infinite ease-in-out;
}
.ask-ai__dots span:nth-child(2) { animation-delay: 0.15s; }
.ask-ai__dots span:nth-child(3) { animation-delay: 0.3s; }
@keyframes ask-ai-bounce {
  0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-3px); }
}

.ask-ai__form {
  display: flex;
  gap: 8px;
  align-items: flex-end;
  padding: 12px 14px;
  border-top: 1px solid var(--border-soft);
  background: var(--white);
  flex-shrink: 0;
}
.ask-ai__form textarea {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  resize: none;
  font-family: var(--font-body);
  font-size: 0.9rem;
  line-height: 1.5;
  max-height: 120px;
  padding: 8px 4px;
  color: var(--ink);
  min-height: 20px;
}
.ask-ai__form textarea::placeholder { color: var(--slate-300); }
.ask-ai__form button {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--red);
  color: var(--white);
  border: none;
  cursor: pointer;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  font-size: 0.85rem;
  transition: background var(--transition), transform var(--transition);
}
.ask-ai__form button:hover:not(:disabled) {
  background: var(--deep-red);
  transform: scale(1.05);
}
.ask-ai__form button:disabled { background: var(--slate-300); cursor: not-allowed; }

@media (max-width: 640px) {
  #ask-ai-fab { bottom: 16px; right: 16px; padding: 11px 16px; font-size: 0.85rem; }
  #ask-ai-panel { bottom: 0; right: 0; left: 0; width: 100%; height: 100vh; max-width: none; max-height: none; border-radius: 0; }
}

@media (prefers-reduced-motion: reduce) {
  #ask-ai-fab, #ask-ai-panel { transition: none !important; }
}

/* ============================================================
   Wider content area on Studying Lab pages
   Removes the empty right-hand gap on desktop.
   ============================================================ */

body:has(.lab-bar) .page-inner,
body:has(.lab-bar) .viz-inner,
body:has(.lab-bar) .fc-inner,
body:has(.lab-bar) .pr-inner,
body:has(.lab-bar) .sp-inner,
body:has(.lab-bar) .qh-inner,
body:has(.lab-bar) .exam-inner {
  max-width: 1440px;
}

/* Also widen the tool grid on lab.html so cards stretch evenly */
body:has(.lab-bar) .tool-grid,
.tool-grid {
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
}
/* ---------- Sidebar support link ---------- */
.nav-item--support {
  position: relative;
  color: rgba(255, 255, 255, 0.82) !important;
}

.nav-item--support:hover {
  color: #FFFFFF !important;
  background: rgba(230, 17, 30, 0.15) !important;
}

.nav-item--support i {
  color: var(--gold) !important;
}

.nav-item__badge {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  border-radius: 999px;
  background: var(--red);
  color: #FFFFFF;
  font-family: var(--font-ui);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(230, 17, 30, 0.4);
}
/* ---------- Admin bar support badge ---------- */
.admin-bar__badge-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 18px;
  height: 18px;
  padding: 0 6px;
  margin-left: 6px;
  border-radius: 999px;
  background: var(--red);
  color: #FFFFFF;
  font-family: var(--font-ui);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  box-shadow: 0 2px 6px rgba(230, 17, 30, 0.4);
  flex-shrink: 0;
  vertical-align: middle;
}
/* ============================================================
   GLOBAL LAYOUT FIX — fill the viewport, no right-side gap
   Added 2026-09-28
   ------------------------------------------------------------
   Pages can opt into a narrower content width by setting:
     :root { --page-max-width: 1040px; }
   in their own <style>. Default is full width.
   ============================================================ */

html, body {
  width: 100% !important;
  max-width: 100% !important;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

.app {
  display: flex !important;
  width: 100% !important;
  max-width: 100% !important;
  min-height: 100vh;
  margin: 0 !important;
  padding: 0 !important;
  align-items: stretch;
}

/* Sidebar keeps its own width; it does not grow */
.app > .sidebar,
.app > #sidebar-mount,
#sidebar-mount > .sidebar {
  flex: 0 0 auto;
}

/* Main column must grow to fill all remaining width */
main.page {
  flex: 1 1 auto !important;
  min-width: 0 !important;
  width: auto !important;
  max-width: 100% !important;
  display: flex !important;
  flex-direction: column;
  overflow-x: hidden;
}

/* Scrollable region: full width of main.page */
main.page .page-scroll {
  flex: 1 1 auto;
  width: 100% !important;
  max-width: 100% !important;
  box-sizing: border-box;
  overflow-y: auto;
  overflow-x: hidden;
  margin: 0;
}

/* Content wrapper: full width unless the page opts in */
main.page .page-inner {
  width: 100% !important;
  max-width: var(--page-max-width, 100%) !important;
  box-sizing: border-box;
  margin-left: auto !important;
  margin-right: auto !important;
}

/* On ultra-wide screens, keep things readable by default */
@media (min-width: 1920px) {
  main.page .page-inner {
    max-width: var(--page-max-width, 1680px) !important;
  }
}

/* ============================================================
   END GLOBAL LAYOUT FIX
   ============================================================ */

/* ============================================================
   ASK AI FLOATING PANEL — layout-safe override
   Added 2026-09-28
   ------------------------------------------------------------
   Uses transform instead of negative `right` offsets, so the
   hidden state can never extend the page width.
   ============================================================ */

#ask-ai-fab {
  position: fixed !important;
  bottom: 24px !important;
  right: 24px !important;
  left: auto !important;
  top: auto !important;
  z-index: 9000 !important;
  /* No transforms that could shift layout */
  transform: none !important;
  max-width: calc(100vw - 48px);
  box-sizing: border-box;
}

#ask-ai-panel {
  position: fixed !important;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: auto !important;
  width: 420px !important;
  max-width: 100vw !important;
  height: 100vh !important;
  max-height: 100vh !important;
  z-index: 9001 !important;
  box-sizing: border-box;
  /* Hide off-screen with transform — does not affect layout */
  transform: translateX(105%) !important;
  transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1) !important;
  will-change: transform;
  overflow-y: auto;
}

#ask-ai-panel.is-open {
  transform: translateX(0) !important;
}

/* Belt and braces: ensure body cannot scroll horizontally */
html, body {
  overflow-x: hidden;
}

/* On mobile, panel fills the screen */
@media (max-width: 640px) {
  #ask-ai-panel {
    width: 100vw !important;
  }
}

/* ============================================================
   GLOBAL LAYOUT + ASK AI FIX (authoritative)
   Added 2026-09-28
   ============================================================ */

/* --- Prevent any horizontal overflow globally --- */
html, body {
  overflow-x: hidden !important;
  max-width: 100vw !important;
}

/* --- App shell: proper flex chain --- */
.app {
  display: flex !important;
  align-items: stretch !important;
  width: 100% !important;
  max-width: 100% !important;
  min-height: 100vh;
  margin: 0 !important;
  padding: 0 !important;
}

.app > .sidebar,
#sidebar-mount {
  flex: 0 0 auto;
}

main.page {
  flex: 1 1 auto !important;
  min-width: 0 !important;
  max-width: 100% !important;
  display: flex !important;
  flex-direction: column;
  overflow-x: hidden;
}

main.page .page-scroll {
  flex: 1 1 auto;
  width: 100% !important;
  max-width: 100% !important;
  box-sizing: border-box;
  overflow-y: auto;
  overflow-x: hidden;
  margin: 0 !important;
}

main.page .page-inner {
  width: 100% !important;
  max-width: var(--page-max-width, 100%) !important;
  box-sizing: border-box;
  margin-left: auto !important;
  margin-right: auto !important;
}

/* --- Ask AI FAB: never touches layout --- */
#ask-ai-fab {
  position: fixed !important;
  top: auto !important;
  bottom: 24px !important;
  left: auto !important;
  right: 24px !important;
  z-index: 9000 !important;
  max-width: calc(100vw - 48px) !important;
  box-sizing: border-box !important;
  transform: none !important;
}
#ask-ai-fab.is-hidden {
  opacity: 0 !important;
  transform: none !important;
  pointer-events: none !important;
  visibility: hidden !important;
}

/* --- Ask AI panel: transform-based hiding, no layout impact --- */
#ask-ai-panel {
  position: fixed !important;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: auto !important;
  width: 420px !important;
  max-width: 100vw !important;
  height: 100vh !important;
  max-height: 100vh !important;
  z-index: 9001 !important;
  box-sizing: border-box !important;
  transform: translateX(101%) !important;
  transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1) !important;
  visibility: hidden !important;
  pointer-events: none !important;
  overflow: hidden !important;
}
#ask-ai-panel.is-open {
  transform: translateX(0) !important;
  visibility: visible !important;
  pointer-events: auto !important;
}

@media (max-width: 640px) {
  #ask-ai-panel { width: 100vw !important; }
}

/* ============================================================
   END ASK AI FIX
   ============================================================ */

/* ============================================================
   SIDEBAR DRAWER + VIDEO SECTION + HEADER TIGHTENING
   Added 2026-09-28
   ============================================================ */

/* ---- Sidebar footer: more toggle ---- */
.sidebar__more-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  padding: 8px 12px;
  margin: 4px 0 6px;
  background: transparent;
  border: 1px dashed rgba(255,255,255,0.14);
  border-radius: 9px;
  color: rgba(255,255,255,0.6);
  font-family: var(--font-ui);
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 600;
  cursor: pointer;
  transition: border-color 200ms ease, color 200ms ease, background 200ms ease;
  -webkit-tap-highlight-color: transparent;
}
.sidebar__more-toggle:hover {
  background: rgba(255,255,255,0.06);
  border-color: rgba(255,255,255,0.28);
  color: #fff;
}
.sidebar__more-toggle__label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.sidebar__more-toggle i.fa-chevron-down {
  transition: transform 280ms cubic-bezier(0.16,1,0.3,1);
  font-size: 0.7rem;
  color: rgba(255,255,255,0.5);
}
.sidebar__more-toggle.is-open i.fa-chevron-down {
  transform: rotate(180deg);
  color: var(--gold);
}
.sidebar__more-toggle.is-open {
  color: #fff;
  border-style: solid;
  border-color: rgba(255,255,255,0.22);
}

/* ---- Sidebar footer: collapsible drawer ---- */
.sidebar__drawer {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition:
    max-height 380ms cubic-bezier(0.16, 1, 0.3, 1),
    opacity 240ms ease,
    margin 240ms ease;
  margin: 0;
}
.sidebar__drawer.is-open {
  max-height: 420px;
  opacity: 1;
  margin: 2px 0 8px;
}

/* ---- Global: tighten page header padding ---- */
main.page .page-header,
main.page .page-header--lg,
.page-header {
  padding-top: 8px !important;
  padding-bottom: 14px !important;
  margin-bottom: 18px !important;
  min-height: 0 !important;
}
.page-header__title {
  margin-bottom: 4px !important;
  font-size: clamp(1.35rem, 2.4vw, 1.75rem) !important;
}
.page-header__sub {
  font-size: 0.88rem !important;
  line-height: 1.5 !important;
}
@media (max-width: 640px) {
  main.page .page-header,
  .page-header {
    padding-top: 4px !important;
    padding-bottom: 10px !important;
    margin-bottom: 14px !important;
  }
  .page-header__title { font-size: 1.25rem !important; }
  .page-header__sub   { font-size: 0.82rem !important; }
}

/* ============================================================
   VIDEO / IFRAME SECTION (used on About + Achievements)
   ============================================================ */

.video-section {
  margin: 0 0 48px;
}
.video-section__head {
  text-align: center;
  margin-bottom: 20px;
}
.video-section__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-family: var(--font-ui);
  font-size: 0.62rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gold);
  font-weight: 700;
  margin-bottom: 10px;
}
.video-section__title {
  font-family: var(--font-head);
  font-size: clamp(1.4rem, 2.8vw, 1.9rem);
  font-weight: 600;
  color: var(--navy);
  margin: 0 0 8px;
  letter-spacing: -0.02em;
  line-height: 1.2;
}
.video-section__sub {
  color: var(--slate);
  font-size: 0.94rem;
  margin: 0;
  max-width: 560px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.6;
}

/* Frame: 16:9 aspect, dark bg, subtle border */
.video-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 20px;
  overflow: hidden;
  background: linear-gradient(155deg, #11104A, #201F6B);
  box-shadow:
    0 24px 60px rgba(17,16,74,0.28),
    0 0 0 1px rgba(201,149,46,0.14);
  transition: transform 400ms cubic-bezier(0.16,1,0.3,1),
              box-shadow 400ms ease;
}
.video-frame:hover {
  transform: translateY(-3px);
  box-shadow:
    0 32px 76px rgba(17,16,74,0.36),
    0 0 0 1px rgba(201,149,46,0.28);
}
.video-frame iframe,
.video-frame video {
  width: 100%;
  height: 100%;
  border: 0;
  display: block;
  background: #000;
}

/* Animated placeholder when no video URL is set */
.video-frame__placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  overflow: hidden;
  text-align: center;
  padding: 24px;
}
.video-frame__orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  pointer-events: none;
}
.video-frame__orb--1 {
  width: 40%; height: 40%;
  background: #C9952E;
  top: -10%; left: -5%;
  opacity: 0.45;
  animation: videoOrb 14s ease-in-out infinite;
}
.video-frame__orb--2 {
  width: 32%; height: 32%;
  background: #E6111E;
  bottom: -10%; right: -5%;
  opacity: 0.32;
  animation: videoOrb 18s ease-in-out infinite reverse;
}
.video-frame__orb--3 {
  width: 26%; height: 26%;
  background: #6E6BE5;
  top: 40%; right: 15%;
  opacity: 0.28;
  animation: videoOrb 22s ease-in-out infinite;
}
@keyframes videoOrb {
  0%, 100% { transform: translate(0,0) scale(1); }
  50%      { transform: translate(20px,-14px) scale(1.15); }
}
.video-frame__grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 42px 42px;
  mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  pointer-events: none;
}
.video-frame__play {
  position: relative;
  width: 82px; height: 82px;
  border-radius: 50%;
  background: linear-gradient(135deg, #E6111E, #B80F1A);
  display: grid;
  place-items: center;
  font-size: 1.9rem;
  color: #fff;
  box-shadow:
    0 12px 34px rgba(230,17,30,0.45),
    0 0 0 8px rgba(255,255,255,0.06);
  animation: playPulse 2.6s ease-in-out infinite;
  z-index: 2;
}
@keyframes playPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 12px 34px rgba(230,17,30,0.45), 0 0 0 8px rgba(255,255,255,0.06); }
  50%      { transform: scale(1.05); box-shadow: 0 16px 42px rgba(230,17,30,0.55), 0 0 0 14px rgba(255,255,255,0.03); }
}
.video-frame__play i { margin-left: 5px; }
.video-frame__caption {
  position: relative;
  z-index: 2;
  margin-top: 18px;
  font-family: var(--font-head);
  font-size: 1.05rem;
  font-weight: 600;
  color: #fff;
  letter-spacing: -0.01em;
}
.video-frame__note {
  position: relative;
  z-index: 2;
  margin-top: 6px;
  font-family: var(--font-ui);
  font-size: 0.6rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  font-weight: 600;
}

@media (max-width: 640px) {
  .video-frame { border-radius: 16px; }
  .video-frame__play { width: 64px; height: 64px; font-size: 1.5rem; }
  .video-frame__caption { font-size: 0.94rem; }
  .video-section { margin-bottom: 36px; }
}

/* ============================================================
   END SIDEBAR DRAWER + VIDEO SECTION
   ============================================================ */

/* ============================================================
   ADMIN BAR + LAB BAR — mobile fixes
   Added 2026-09-29
   ============================================================ */

/* Make nav rows horizontally scrollable when they overflow */
.admin-bar__nav,
.lab-bar__nav {
  display: flex !important;
  gap: 4px !important;
  overflow-x: auto !important;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scroll-behavior: smooth;
  padding-bottom: 2px;
}
.admin-bar__nav::-webkit-scrollbar,
.lab-bar__nav::-webkit-scrollbar {
  height: 4px;
}
.admin-bar__nav::-webkit-scrollbar-track,
.lab-bar__nav::-webkit-scrollbar-track {
  background: rgba(17,16,74,0.06);
  border-radius: 2px;
}
.admin-bar__nav::-webkit-scrollbar-thumb,
.lab-bar__nav::-webkit-scrollbar-thumb {
  background: rgba(17,16,74,0.24);
  border-radius: 2px;
}

/* Prevent shrink on nav links so they scroll instead of squishing */
.admin-bar__link,
.lab-bar__link {
  flex-shrink: 0 !important;
  white-space: nowrap !important;
}

/* Top row on mobile — stack comfortably */
@media (max-width: 640px) {
  .admin-bar,
  .lab-bar {
    padding: 10px 12px !important;
  }
  .admin-bar__row,
  .lab-bar__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
    flex-wrap: nowrap;
  }
  .admin-bar__back,
  .lab-bar__back {
    flex-shrink: 0;
    padding: 8px 12px !important;
    font-size: 0.78rem !important;
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .admin-bar__back span,
  .lab-bar__back span {
    /* Keep the label visible on mobile but smaller */
    font-size: 0.78rem;
  }
  .admin-bar__badge,
  .lab-bar__badge {
    flex-shrink: 0;
    font-size: 0.6rem !important;
    padding: 5px 10px !important;
  }
  .admin-bar__link,
  .lab-bar__link {
    padding: 8px 12px !important;
    font-size: 0.74rem !important;
    min-height: 36px;
    display: inline-flex !important;
    align-items: center;
    gap: 5px;
  }
  .admin-bar__link i,
  .lab-bar__link i {
    font-size: 0.8rem;
  }
  .admin-bar__link span,
  .lab-bar__link span {
    /* Text label stays visible so students know where they're going */
    font-size: 0.74rem;
  }
}

/* Very small screens (< 380px) — hide text, show icons only */
@media (max-width: 380px) {
  .admin-bar__back span,
  .lab-bar__back span,
  .admin-bar__link span,
  .lab-bar__link span {
    display: none;
  }
  .admin-bar__link,
  .lab-bar__link {
    padding: 8px 10px !important;
  }
  .admin-bar__back,
  .lab-bar__back {
    padding: 8px 10px !important;
  }
}

/* ============================================================
   USER BADGES (protected + verified) — visible in admin tables
   ============================================================ */
.user-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px;
  border-radius: 999px;
  font-family: var(--font-ui);
  font-size: 0.58rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-weight: 700;
  white-space: nowrap;
  vertical-align: middle;
  line-height: 1.4;
}
.user-badge i { font-size: 0.62rem; }

.user-badge--protected {
  background: linear-gradient(135deg, #FBF3E1, #F4E2B8);
  color: #6A4F13;
  border: 1px solid rgba(201,149,46,0.4);
}

.user-badge--verified {
  background: linear-gradient(135deg, #ECEBF5, #DAD8EA);
  color: var(--navy);
  border: 1px solid rgba(17,16,74,0.18);
}

.user-badge--suspended {
  background: #FDECEC;
  color: var(--deep-red);
  border: 1px solid rgba(230,17,30,0.3);
}

.user-badge--you {
  background: linear-gradient(135deg, var(--red), var(--deep-red));
  color: #fff;
  border: 1px solid transparent;
}

/* ============================================================
   END ADMIN MOBILE + BADGES
   ============================================================ */

/* ============================================================
   MOBILE MODE — DAY 1-2
   Bottom nav, safe areas, touch targets, action sheet.
   ============================================================ */

/* ---------- Bottom navigation bar ---------- */
.bottom-nav {
  display: none;
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 400;
  background: rgba(17,16,74,0.97);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-top: 1px solid rgba(255,255,255,0.08);
  padding-bottom: env(safe-area-inset-bottom, 0);
  padding-left: env(safe-area-inset-left, 0);
  padding-right: env(safe-area-inset-right, 0);
  box-shadow: 0 -6px 24px rgba(17,16,74,0.18);
  transition: transform 260ms ease;
}
.bottom-nav__inner {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  max-width: 640px;
  margin: 0 auto;
  height: 62px;
}
.bottom-nav__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  background: none;
  border: none;
  color: rgba(255,255,255,0.62);
  font-family: var(--font-ui);
  font-size: 0.6rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  -webkit-tap-highlight-color: transparent;
  transition: color 200ms ease, transform 120ms ease;
  padding: 6px 4px;
  min-height: 48px;
}
.bottom-nav__item i {
  font-size: 1.15rem;
  transition: transform 200ms ease;
}
.bottom-nav__item:active { transform: scale(0.94); }
.bottom-nav__item.is-active { color: var(--gold); }
.bottom-nav__item.is-active i { transform: translateY(-1px); }
.bottom-nav__item.is-active::after {
  content: '';
  position: absolute;
  top: 0;
  width: 24px;
  height: 2px;
  border-radius: 0 0 2px 2px;
  background: var(--gold);
}
.bottom-nav__item { position: relative; }

/* ---------- More sheet ---------- */
.more-sheet-overlay {
  position: fixed; inset: 0;
  background: rgba(17,16,74,0.55);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 9000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  transition: opacity 240ms ease;
  padding: 0;
}
.more-sheet-overlay.is-open { opacity: 1; }
.more-sheet {
  width: 100%;
  max-width: 520px;
  background: var(--white);
  border-radius: 22px 22px 0 0;
  padding: 8px 0 calc(20px + env(safe-area-inset-bottom, 0));
  transform: translateY(100%);
  transition: transform 320ms cubic-bezier(0.16,1,0.3,1);
  max-height: 88vh;
  overflow-y: auto;
  box-shadow: 0 -12px 40px rgba(17,16,74,0.32);
}
.more-sheet-overlay.is-open .more-sheet { transform: translateY(0); }
.more-sheet__handle {
  width: 44px; height: 4px;
  border-radius: 4px;
  background: rgba(17,16,74,0.18);
  margin: 8px auto 14px;
}
.more-sheet__title {
  font-family: var(--font-ui);
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--slate);
  font-weight: 700;
  padding: 6px 22px;
}
.more-sheet__list {
  display: flex;
  flex-direction: column;
  padding: 4px 8px;
}
.more-sheet__item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 18px;
  border-radius: 12px;
  border: none;
  background: transparent;
  color: var(--navy);
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  text-align: left;
  cursor: pointer;
  width: 100%;
  min-height: 52px;
  -webkit-tap-highlight-color: transparent;
  transition: background 140ms ease;
}
.more-sheet__item:hover,
.more-sheet__item:active { background: var(--blush); }
.more-sheet__item i {
  width: 24px;
  text-align: center;
  font-size: 1.05rem;
  color: var(--slate);
}
.more-sheet__item.is-danger { color: var(--deep-red); }
.more-sheet__item.is-danger i { color: var(--deep-red); }

/* ---------- Action sheet (chat message actions) ---------- */
.action-sheet-overlay {
  position: fixed; inset: 0;
  background: rgba(17,16,74,0.55);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 9100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  transition: opacity 240ms ease;
}
.action-sheet-overlay.is-open { opacity: 1; }
.action-sheet {
  width: 100%;
  max-width: 520px;
  background: var(--white);
  border-radius: 22px 22px 0 0;
  padding: 8px 12px calc(16px + env(safe-area-inset-bottom, 0));
  transform: translateY(100%);
  transition: transform 320ms cubic-bezier(0.16,1,0.3,1);
  box-shadow: 0 -12px 40px rgba(17,16,74,0.32);
}
.action-sheet-overlay.is-open .action-sheet { transform: translateY(0); }
.action-sheet__handle {
  width: 44px; height: 4px;
  border-radius: 4px;
  background: rgba(17,16,74,0.18);
  margin: 8px auto 12px;
}
.action-sheet__title {
  font-family: var(--font-ui);
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--slate);
  font-weight: 700;
  padding: 4px 12px 10px;
}
.action-sheet__body {
  display: flex;
  flex-direction: column;
}
.action-sheet .msg-actions {
  display: flex !important;
  flex-direction: column;
  gap: 2px;
  opacity: 1;
  margin: 0;
  padding: 0;
}
.action-sheet .msg-action {
  width: 100%;
  min-height: 52px;
  padding: 14px 18px;
  border-radius: 12px;
  border: none;
  background: transparent;
  color: var(--navy);
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 600;
  letter-spacing: 0;
  text-transform: none;
  justify-content: flex-start;
  gap: 14px;
  display: inline-flex;
  align-items: center;
  transition: background 140ms ease;
}
.action-sheet .msg-action:hover,
.action-sheet .msg-action:active { background: var(--blush); }
.action-sheet .msg-action i {
  font-size: 1.05rem;
  width: 24px;
  text-align: center;
  color: var(--slate);
}
.action-sheet .msg-action.is-done { color: #2F8F4A; background: #EAF7EE; }
.action-sheet .msg-action.is-done i { color: #2F8F4A; }
.action-sheet__cancel {
  margin-top: 8px;
  padding: 15px;
  border-radius: 12px;
  border: none;
  background: var(--blush);
  color: var(--slate);
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
  width: 100%;
  min-height: 52px;
}

/* ============================================================
   MOBILE VIEWPORT (≤ 860px)
   ============================================================ */
@media (max-width: 860px) {

  /* Sidebar hidden by default — still reachable from hamburger */
  .sidebar { transform: translateX(-100%); transition: transform 280ms cubic-bezier(0.16,1,0.3,1); }
  .sidebar.is-open { transform: translateX(0); }

  /* Bottom nav becomes visible */
  .bottom-nav { display: block; }

  /* Reserve space for bottom nav */
  body.has-bottom-nav { padding-bottom: 0; }
  body.has-bottom-nav .app,
  body.has-bottom-nav main.page,
  body.has-bottom-nav .chat-main {
    padding-bottom: calc(62px + env(safe-area-inset-bottom, 0px));
  }

  /* Safe areas on left/right */
  main.page .page-scroll,
  .chat-scroll {
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
  }

  /* Composer sits above the keyboard */
  .composer-wrap {
    padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  }

  /* Hide inline message actions on mobile — tap opens the action sheet instead */
  .msg-actions { display: none; }

  /* Touch target minimums */
  .composer-btn { width: 44px; height: 44px; font-size: 0.95rem; }
  .conv-item__menu-btn { width: 40px; height: 40px; opacity: 1; }
  .attach-chip__remove { width: 30px; height: 30px; font-size: 0.7rem; }
  .suggestion-card { min-height: 84px; }
  .qa-btn, .qa-opt, .practice-btn, .flashcard-rate-btn { min-height: 46px; }
  .qa-opt { padding: 12px 14px; }
  .tool-card { min-height: 72px; }

  /* Slightly larger body text on small screens */
  .msg-content { font-size: 0.97rem; }

  /* Chat inner: use full available width */
  .chat-inner { max-width: 100%; }

  /* Remove hover-only reveals */
  .msg-row--ai .msg-actions { opacity: 1; }

  /* Mobile bar styling (chat only) */
  .mobile-bar {
    padding-top: env(safe-area-inset-top, 0);
  }

  /* Active state feedback on tap */
  .bottom-nav__item:active { background: rgba(255,255,255,0.04); }
}

/* Small phones — tighter everything */
@media (max-width: 480px) {
  .chat-scroll { padding-left: 12px; padding-right: 12px; }
  main.page .page-scroll { padding-left: 12px; padding-right: 12px; }
  .bottom-nav__item span { font-size: 0.56rem; }
  .msg-body { max-width: 92%; }
}

/* ============================================================
   HARDENED MOBILE SIDEBAR — takes it out of flex flow
   Applied 2026-10-05
   ============================================================ */
@media (max-width: 860px) {

  /* Force the sidebar to overlay the page, not sit in the flex row */
  .sidebar {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    height: 100vh !important;
    height: 100dvh !important;
    width: 280px !important;
    max-width: 85vw !important;
    z-index: 999 !important;
    flex: none !important;
    transform: translateX(-105%) !important;
    transition: transform 280ms cubic-bezier(0.16,1,0.3,1) !important;
    box-shadow: 4px 0 30px rgba(17,16,74,0.22) !important;
    overflow-y: auto !important;
    padding-top: env(safe-area-inset-top, 0) !important;
    padding-bottom: env(safe-area-inset-bottom, 0) !important;
  }
  .sidebar.is-open {
    transform: translateX(0) !important;
  }

  /* The .app wrapper should not reserve any width for the sidebar on mobile */
  .app {
    padding-left: 0 !important;
    margin-left: 0 !important;
  }

  /* #sidebar-mount should not create a gap */
  #sidebar-mount {
    width: 0 !important;
    height: 0 !important;
    overflow: visible !important;
    position: static !important;
    flex: none !important;
  }

  /* Main column takes the full width */
  main.page,
  main.chat-main {
    margin-left: 0 !important;
    padding-left: 0 !important;
    flex: 1 1 100% !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  /* Backdrop for when the drawer is open */
  .backdrop.is-open {
    display: block !important;
    position: fixed !important;
    inset: 0 !important;
    background: rgba(17,16,74,0.5) !important;
    backdrop-filter: blur(3px) !important;
    -webkit-backdrop-filter: blur(3px) !important;
    z-index: 998 !important;
  }

  /* Ensure mobile bar (hamburger) shows */
  .mobile-bar {
    display: flex !important;
  }
}

/* ============================================================
   MOBILE SIDEBAR — NUCLEAR (display:none unless open)
   ============================================================ */
@media (max-width: 860px) {
  /* Sidebar is invisible and takes zero space unless explicitly opened */
  .sidebar:not(.is-open) {
    display: none !important;
  }
  .sidebar.is-open {
    display: flex !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    height: 100vh !important;
    height: 100dvh !important;
    width: 280px !important;
    max-width: 85vw !important;
    z-index: 9999 !important;
    transform: none !important;
    box-shadow: 4px 0 30px rgba(17,16,74,0.3) !important;
    overflow-y: auto !important;
    padding-top: env(safe-area-inset-top, 0) !important;
    padding-bottom: env(safe-area-inset-bottom, 0) !important;
  }
  #sidebar-mount {
    width: 0 !important;
    min-width: 0 !important;
    max-width: 0 !important;
    overflow: visible !important;
    flex: 0 0 0 !important;
  }
  main.page,
  main.chat-main,
  main {
    margin-left: 0 !important;
    padding-left: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    flex: 1 1 100% !important;
  }
  .app {
    padding-left: 0 !important;
    margin-left: 0 !important;
    gap: 0 !important;
  }
}

/* ============================================================
   MOBILE POLISH — 2026-10-05
   • Hide the collapse/expand toggle inside the sidebar header
     on mobile (redundant inside a drawer)
   • Move Ask AI FAB above the bottom nav so it never covers
     the "More" tab
   • Layer the More sheet and Action sheet above the FAB
   ============================================================ */

@media (max-width: 860px) {

  /* 1) Hide the collapse/expand hamburger inside the sidebar header.
        The drawer is opened from the top bar's hamburger and closed
        by tapping the backdrop — this button is redundant on mobile. */
  .sidebar__toggle {
    display: none !important;
  }

  /* Give the sidebar header a bit more padding since the toggle is gone */
  .sidebar__header {
    padding-left: 16px !important;
  }

  /* 2) Move the Ask AI FAB above the bottom nav so it doesn't
        cover the "More" tab. Bottom nav is 62px + safe-area. */
  #ask-ai-fab {
    bottom: calc(62px + 22px + env(safe-area-inset-bottom, 0px)) !important;
    right: 16px !important;
    padding: 12px 18px !important;
    font-size: 0.88rem !important;
    max-width: calc(100vw - 32px) !important;
  }

  /* Slightly smaller icon for balance */
  #ask-ai-fab i { font-size: 0.9rem !important; }

  /* 3) The Ask AI panel opens full-screen on mobile.
        Reserve room at the bottom so the panel's input isn't
        hidden behind the bottom nav when the panel is open. */
  #ask-ai-panel {
    padding-bottom: calc(62px + env(safe-area-inset-bottom, 0px)) !important;
  }
  #ask-ai-panel.is-open {
    z-index: 9500 !important;
  }

  /* 4) The More sheet and Action sheet should sit ABOVE the FAB
        so their buttons aren't occluded. */
  .more-sheet-overlay { z-index: 9600 !important; }
  .action-sheet-overlay { z-index: 9650 !important; }

  /* 5) When the More sheet is open, the FAB hides so the sheet is clean */
  body.sheet-open #ask-ai-fab {
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }
}

/* Also make sure the FAB stays above the bottom nav on tablets */
@media (min-width: 861px) and (max-width: 1100px) {
  #ask-ai-fab {
    bottom: 24px !important;
    right: 24px !important;
  }
}
