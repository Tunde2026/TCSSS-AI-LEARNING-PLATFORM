.admin-bar__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-ui);
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 500;
  color: var(--red);
  background: #FDECEC;
  padding: 5px 12px;
  border-radius: 999px;
}
.admin-bar__badge i { font-size: 0.7rem; }
.admin-bar__nav {
  display: flex;
