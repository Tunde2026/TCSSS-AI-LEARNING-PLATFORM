/* ============================================================
   shell.css
   ------------------------------------------------------------
   The ONE approved shared stylesheet for this project.
   Sections:
     1. Design tokens
     2. Reset & base
     3. Typography
     4. Buttons / inputs / cards
     5. App shell
     6. Sidebar
     7. Conversation list & menu
     8. Modal
     9. Chat area
    10. Mobile bar & backdrop
    11. Responsive
    12. Reduced motion
   ============================================================ */

/* ---------- 1. Design tokens ---------- */
@import url('https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Work+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');
@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css');

:root {
  /* TCSSS palette */
  --navy:       #11104A;
  --soft-navy:  #201F6B;
  --navy-700:   #1A1956;
  --red:        #E6111E;
  --deep-red:   #B80F1A;
  --gold:       #C9952E;
  --blush:      #FBEFEF;
  --blush-deep: #F6E0E0;
  --white:      #FFFFFF;
  --ink:        #1E1D3D;
  --slate:      #5B5A6B;
  --border:     #E7E6EE;
  --border-soft:#F0EFF5;

  /* Typography */
  --font-head: 'Lora', Georgia, serif;
  --font-body: 'Work Sans', system-ui, -apple-system, sans-serif;
  --font-ui:   'JetBrains Mono', ui-monospace, monospace;

  /* Layout */
  --sidebar-w:           268px;
  --sidebar-w-collapsed: 64px;
  --mobile-bar-h:        56px;
  --radius:              14px;
  --radius-sm:           8px;

  /* Shadows */
  --shadow-xs: 0 1px 2px rgba(17, 16, 74, 0.05);
  --shadow-sm: 0 2px 6px rgba(17, 16, 74, 0.06);
  --shadow-md: 0 8px 24px rgba(17, 16, 74, 0.10);
  --shadow-lg: 0 20px 40px rgba(17, 16, 74, 0.18);

  /* Motion */
  --ease:       cubic-bezier(0.4, 0, 0.2, 1);
  --transition: 180ms var(--ease);
}

/* ---------- 2. Reset & base ---------- */
*, *::before, *::after { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  height: 100%;
}

body {
  font-family: var(--font-body);
  font-size: 16px;
  color: var(--ink);
  background: var(--blush);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

button { font: inherit; }
img, svg { display: block; max-width: 100%; }

:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 2px;
  border-radius: 6px;
}

/* ---------- 3. Typography ---------- */
h1, h2, h3, h4 {
  font-family: var(--font-head);
  font-weight: 600;
  color: var(--navy);
  margin: 0 0 0.5em;
  line-height: 1.25;
}
h1 { font-size: 1.75rem; }
h2 { font-size: 1.35rem; }
h3 { font-size: 1.1rem; }

p { line-height: 1.6; margin: 0 0 1em; }
a { color: var(--red); text-decoration: none; }
a:hover { text-decoration: underline; }

/* ---------- 4. Buttons / inputs / cards ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.92rem;
  padding: 0.65em 1.2em;
  border: none;
  border-radius: 999px;
  cursor: pointer;
  transition: background var(--transition), transform var(--transition), color var(--transition);
  white-space: nowrap;
}
.btn:active:not(:disabled) { transform: translateY(1px); }
.btn:disabled { cursor: not-allowed; opacity: 0.55; }

.btn-primary { background: var(--red); color: var(--white); }
.btn-primary:hover:not(:disabled) { background: var(--deep-red); }

.btn-ghost {
  background: transparent;
  color: var(--navy);
  border: 1px solid var(--border);
}
.btn-ghost:hover:not(:disabled) {
  background: var(--blush);
  border-color: var(--navy);
}

.btn-danger {
  background: var(--red);
  color: var(--white);
}
.btn-danger:hover:not(:disabled) { background: var(--deep-red); }

.card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 24px;
  box-shadow: var(--shadow-xs);
}

.input, .textarea {
  width: 100%;
  font-family: var(--font-body);
  font-size: 1rem;
  padding: 0.75em 1em;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--white);
  color: var(--ink);
  transition: border-color var(--transition), box-shadow var(--transition);
}
.input:focus, .textarea:focus {
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(201, 149, 46, 0.15);
}

.label {
  display: block;
  font-family: var(--font-ui);
  font-size: 0.72rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--slate);
  margin-bottom: 6px;
}

/* ---------- 5. App shell ---------- */
.app {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

#sidebar-mount { flex-shrink: 0; }

/* ---------- 6. Sidebar ---------- */
.sidebar {
  width: var(--sidebar-w);
  background: var(--navy);
  color: var(--white);
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  transition: width var(--transition);
}
.sidebar.is-collapsed { width: var(--sidebar-w-collapsed); }

/* Header */
.sidebar__header {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 12px;
  min-height: 60px;
  flex-shrink: 0;
}
.sidebar.is-collapsed .sidebar__header { justify-content: center; padding: 12px 0; }

.sidebar__toggle {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: transparent;
  border: none;
  color: rgba(255,255,255,0.7);
  display: grid;
  place-items: center;
  cursor: pointer;
  flex-shrink: 0;
  font-size: 0.9rem;
  transition: background var(--transition), color var(--transition);
}
.sidebar__toggle:hover {
  background: rgba(255,255,255,0.08);
  color: var(--white);
}

.sidebar__brand {
  display: flex;
  align-items: center;
  gap: 10px;
  overflow: hidden;
  white-space: nowrap;
  min-width: 0;
  transition: opacity var(--transition);
}
.sidebar.is-collapsed .sidebar__brand {
  opacity: 0;
  pointer-events: none;
  width: 0;
}

.sidebar__logo-slot {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background: rgba(255,255,255,0.08);
  display: grid;
  place-items: center;
  font-family: var(--font-ui);
  font-size: 0.5rem;
  color: rgba(255,255,255,0.4);
  flex-shrink: 0;
  letter-spacing: 0.05em;
}

.sidebar__title {
  font-family: var(--font-head);
  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1.15;
  color: var(--white);
}

/* Body */
.sidebar__body {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 4px 8px 8px;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.sidebar__body::-webkit-scrollbar { width: 6px; }
.sidebar__body::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.12);
  border-radius: 3px;
}
.sidebar__body::-webkit-scrollbar-track { background: transparent; }

.sidebar__nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: 12px;
  flex-shrink: 0;
}

.nav-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 9px 12px;
  border-radius: 8px;
  color: rgba(255,255,255,0.72);
  font-family: var(--font-body);
  font-size: 0.88rem;
  font-weight: 500;
  text-decoration: none;
  background: transparent;
  border: none;
  cursor: pointer;
  text-align: left;
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  transition: background var(--transition), color var(--transition);
}
.nav-item:hover {
  background: rgba(255,255,255,0.07);
  color: var(--white);
  text-decoration: none;
}
.nav-item.is-active {
  background: rgba(255,255,255,0.1);
  color: var(--white);
}
.nav-item.is-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 18px;
  background: var(--gold);
  border-radius: 0 3px 3px 0;
}
.nav-item i {
  font-size: 0.95rem;
  width: 18px;
  text-align: center;
  flex-shrink: 0;
}
.sidebar.is-collapsed .nav-item {
  justify-content: center;
  padding: 9px 0;
}
.sidebar.is-collapsed .nav-item span { display: none; }
.sidebar.is-collapsed .nav-item.is-active::before { display: none; }

/* Footer */
.sidebar__footer {
  padding: 8px;
  border-top: 1px solid rgba(255,255,255,0.08);
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex-shrink: 0;
}

.nav-item--utility {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.45);
}
.sidebar.is-collapsed .nav-item--utility span { display: none; }

/* User chip */
.user-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 8px 4px;
  margin-top: 4px;
  border-top: 1px solid rgba(255,255,255,0.06);
  overflow: hidden;
}
.user-chip__avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--gold);
  color: var(--navy);
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 0.85rem;
  flex-shrink: 0;
}
.user-chip__info { overflow: hidden; min-width: 0; }
.user-chip__name {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--white);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.user-chip__email {
  font-size: 0.68rem;
  color: rgba(255,255,255,0.45);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sidebar.is-collapsed .user-chip { justify-content: center; padding: 10px 0 4px; }
.sidebar.is-collapsed .user-chip__info { display: none; }

/* ---------- 7. Conversation list & menu ---------- */
.new-chat-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 10px 12px;
  margin-bottom: 14px;
  border-radius: 10px;
  background: var(--red);
  color: var(--white);
  border: none;
  font-family: var(--font-body);
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--transition);
  flex-shrink: 0;
}
.new-chat-btn:hover { background: var(--deep-red); }
.new-chat-btn i { font-size: 0.9rem; }
.sidebar.is-collapsed .new-chat-btn {
  justify-content: center;
  padding: 10px 0;
}
.sidebar.is-collapsed .new-chat-btn span { display: none; }

.conv-group {
  margin-bottom: 12px;
}
.conv-group__label {
  font-family: var(--font-ui);
  font-size: 0.66rem;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.38);
  padding: 6px 12px 6px;
  font-weight: 500;
}
.sidebar.is-collapsed .conv-group__label { display: none; }
.sidebar.is-collapsed .conv-group { margin-bottom: 6px; }

.conv-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 6px;
  width: 100%;
  padding: 8px 8px 8px 12px;
  border-radius: 8px;
  background: transparent;
  border: none;
  color: rgba(255,255,255,0.72);
  font-family: var(--font-body);
  font-size: 0.85rem;
  text-align: left;
  cursor: pointer;
  transition: background var(--transition), color var(--transition);
}
.conv-item:hover {
  background: rgba(255,255,255,0.06);
  color: var(--white);
}
.conv-item.is-active {
  background: rgba(255,255,255,0.12);
  color: var(--white);
}
.sidebar.is-collapsed .conv-item { display: none; }

.conv-item__title {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}
.conv-item__pin {
  color: var(--gold);
  font-size: 0.65rem;
  flex-shrink: 0;
}

.conv-item__menu-btn {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  border-radius: 6px;
  border: none;
  background: transparent;
  color: rgba(255,255,255,0.7);
  cursor: pointer;
  display: grid;
  place-items: center;
  opacity: 0;
  transition: opacity var(--transition), background var(--transition);
}
.conv-item:hover .conv-item__menu-btn { opacity: 1; }
.conv-item__menu-btn:hover { background: rgba(255,255,255,0.1); color: var(--white); }
.conv-item__menu-btn.is-open { opacity: 1; background: rgba(255,255,255,0.1); }

/* Inline rename input */
.conv-item__rename-input {
  flex: 1;
  background: rgba(0,0,0,0.25);
  border: 1px solid var(--gold);
  border-radius: 6px;
  color: var(--white);
  font-family: var(--font-body);
  font-size: 0.85rem;
  padding: 4px 8px;
  min-width: 0;
  outline: none;
}

/* Dropdown menu */
.conv-menu {
  position: fixed;
  z-index: 100;
  min-width: 160px;
  background: var(--white);
  border-radius: 10px;
  box-shadow: var(--shadow-lg);
  padding: 4px;
  display: flex;
  flex-direction: column;
}
.conv-menu__item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border-radius: 6px;
  background: transparent;
  border: none;
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 0.85rem;
  text-align: left;
  cursor: pointer;
  transition: background var(--transition);
}
.conv-menu__item:hover { background: var(--blush); }
.conv-menu__item i { width: 14px; text-align: center; font-size: 0.8rem; }
.conv-menu__item--danger { color: var(--deep-red); }
.conv-menu__item--danger:hover { background: #FCECEC; }

/* ---------- 8. Modal ---------- */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(17,16,74,0.5);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 24px;
  opacity: 0;
  transition: opacity var(--transition);
}
.modal-overlay.is-open {
  display: flex;
  opacity: 1;
}
.modal {
  width: 100%;
  max-width: 400px;
  background: var(--white);
  border-radius: var(--radius);
  padding: 24px;
  box-shadow: var(--shadow-lg);
  animation: modal-in 180ms var(--ease);
}
@keyframes modal-in {
  from { transform: translateY(8px); opacity: 0; }
  to   { transform: translateY(0);   opacity: 1; }
}
.modal__title {
  font-family: var(--font-head);
  font-size: 1.15rem;
  color: var(--navy);
  margin: 0 0 8px;
}
.modal__body {
  color: var(--slate);
  font-size: 0.92rem;
  margin: 0 0 20px;
  line-height: 1.5;
}
.modal__actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
}

/* ---------- 9. Chat area ---------- */
.chat-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  background: var(--blush);
  height: 100vh;
  overflow: hidden;
}

.chat-topbar {
  height: 56px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 0 24px;
  border-bottom: 1px solid var(--border-soft);
  background: rgba(251, 239, 239, 0.75);
  backdrop-filter: blur(8px);
}
.chat-topbar__title {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--navy);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 32px 24px 32px;
  min-height: 0;
}
.chat-scroll::-webkit-scrollbar { width: 8px; }
.chat-scroll::-webkit-scrollbar-thumb {
  background: rgba(17,16,74,0.12);
  border-radius: 4px;
}

.chat-inner {
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Empty state */
.chat-empty {
  max-width: 640px;
  margin: 40px auto 0;
  text-align: center;
}
.chat-empty__icon {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  background: var(--navy);
  color: var(--white);
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
  font-size: 1.5rem;
}
.chat-empty__title {
  font-family: var(--font-head);
  font-size: 1.9rem;
  font-weight: 600;
  color: var(--navy);
  margin-bottom: 8px;
}
.chat-empty__sub {
  color: var(--slate);
  font-size: 0.98rem;
  margin-bottom: 32px;
}
.chat-empty__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}
.suggestion-card {
  padding: 16px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  text-align: left;
  cursor: pointer;
  transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
  font-family: var(--font-body);
}
.suggestion-card:hover {
  border-color: var(--gold);
  box-shadow: var(--shadow-sm);
  transform: translateY(-1px);
}
.suggestion-card__title {
  font-weight: 600;
  font-size: 0.88rem;
  color: var(--navy);
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.suggestion-card__title i {
  color: var(--red);
  font-size: 0.85rem;
}
.suggestion-card__desc {
  font-size: 0.8rem;
  color: var(--slate);
  line-height: 1.45;
}

/* Messages */
.msg-row {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.msg-row--user { flex-direction: row-reverse; }

.msg-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  font-size: 0.8rem;
}
.msg-row--ai .msg-avatar {
  background: var(--red);
  color: var(--white);
}
.msg-row--user .msg-avatar {
  background: var(--navy);
  color: var(--white);
}

.msg-body { min-width: 0; max-width: 82%; }

.msg-content {
  padding: 12px 16px;
  border-radius: 16px;
  line-height: 1.6;
  white-space: pre-wrap;
  word-wrap: break-word;
  font-size: 0.95rem;
}
.msg-row--ai .msg-content {
  background: var(--white);
  color: var(--ink);
  box-shadow: var(--shadow-xs);
  border-top-left-radius: 6px;
}
.msg-row--user .msg-content {
  background: var(--navy);
  color: var(--white);
  border-top-right-radius: 6px;
}

.msg-meta {
  font-family: var(--font-ui);
  font-size: 0.65rem;
  color: var(--slate);
  margin-top: 6px;
  opacity: 0.7;
  padding: 0 4px;
}
.msg-row--user .msg-meta { text-align: right; }

/* Typing indicator */
.typing {
  display: inline-flex;
  gap: 4px;
  align-items: center;
  padding: 4px 0;
}
.typing span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--slate);
  animation: typing-bounce 1.2s infinite ease-in-out;
}
.typing span:nth-child(2) { animation-delay: 0.15s; }
.typing span:nth-child(3) { animation-delay: 0.3s; }
@keyframes typing-bounce {
  0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-3px); }
}

/* Composer */
.composer-wrap {
  flex-shrink: 0;
  padding: 16px 24px 20px;
  background: linear-gradient(to top, var(--blush) 60%, rgba(251,239,239,0));
}
.composer {
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  gap: 8px;
  align-items: flex-end;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 8px 8px 8px 18px;
  box-shadow: var(--shadow-sm);
  transition: border-color var(--transition), box-shadow var(--transition);
}
.composer:focus-within {
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(201,149,46,0.12);
}
.composer textarea {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  resize: none;
  font-family: var(--font-body);
  font-size: 0.97rem;
  line-height: 1.55;
  max-height: 200px;
  padding: 8px 0;
  color: var(--ink);
  min-height: 22px;
}
.composer textarea::placeholder { color: var(--slate); opacity: 0.65; }

.composer-send {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--red);
  color: var(--white);
  border: none;
  cursor: pointer;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  font-size: 0.85rem;
  transition: background var(--transition), transform var(--transition);
}
.composer-send:hover:not(:disabled) { background: var(--deep-red); }
.composer-send:disabled { background: var(--slate); cursor: not-allowed; opacity: 0.55; }
.composer-send:active:not(:disabled) { transform: scale(0.94); }

.composer-hint {
  max-width: 760px;
  margin: 8px auto 0;
  font-size: 0.7rem;
  color: var(--slate);
  text-align: center;
  opacity: 0.75;
}

/* Generic page container (lab, library, settings) */
.page {
  flex: 1;
  padding: 32px;
  max-width: 1100px;
  overflow-y: auto;
  height: 100vh;
}
.page-placeholder {
  margin-top: 24px;
  padding: 40px;
  text-align: center;
  color: var(--slate);
  border: 2px dashed var(--blush-deep);
  border-radius: var(--radius);
  background: var(--white);
}

/* ---------- 10. Mobile bar & backdrop ---------- */
.mobile-bar {
  display: none;
  position: sticky;
  top: 0;
  z-index: 40;
  height: var(--mobile-bar-h);
  background: var(--navy);
  color: var(--white);
  padding: 0 12px;
  align-items: center;
  gap: 12px;
}
.mobile-bar__toggle {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  background: transparent;
  border: none;
  color: var(--white);
  display: grid;
  place-items: center;
  cursor: pointer;
  font-size: 1rem;
}
.mobile-bar__toggle:hover { background: rgba(255,255,255,0.1); }
.mobile-bar__title {
  font-family: var(--font-head);
  font-size: 1rem;
  font-weight: 600;
}
.backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(17,16,74,0.5);
  z-index: 45;
  opacity: 0;
  transition: opacity var(--transition);
}
.backdrop.is-open { display: block; opacity: 1; }

/* ---------- 11. Responsive ---------- */
@media (max-width: 860px) {
  .app { flex-direction: column; }
  .mobile-bar { display: flex; }

  #sidebar-mount {
    position: fixed;
    top: 0; left: 0;
    z-index: 50;
    height: 100vh;
    width: 0;
  }

  .sidebar {
    position: fixed;
    top: 0; left: 0;
    height: 100vh;
    width: var(--sidebar-w);
    transform: translateX(-100%);
    transition: transform var(--transition);
    box-shadow: var(--shadow-lg);
  }
  .sidebar.is-open { transform: translateX(0); }

  /* Force expanded layout on mobile regardless of stored collapse state */
  .sidebar.is-collapsed { width: var(--sidebar-w); }
  .sidebar.is-collapsed .sidebar__header { justify-content: flex-start; padding: 12px 12px; }
  .sidebar.is-collapsed .sidebar__brand { opacity: 1; width: auto; }
  .sidebar.is-collapsed .nav-item { justify-content: flex-start; padding: 9px 12px; }
  .sidebar.is-collapsed .nav-item span { display: inline; }
  .sidebar.is-collapsed .nav-item.is-active::before { display: block; }
  .sidebar.is-collapsed .user-chip { justify-content: flex-start; padding: 10px 8px 4px; }
  .sidebar.is-collapsed .user-chip__info { display: block; }
  .sidebar.is-collapsed .conv-item { display: flex; }
  .sidebar.is-collapsed .conv-group__label { display: block; }
  .sidebar.is-collapsed .new-chat-btn { justify-content: flex-start; padding: 10px 12px; }
  .sidebar.is-collapsed .new-chat-btn span { display: inline; }

  .chat-topbar { display: none; }
  .chat-scroll { padding: 20px 16px; }
  .composer-wrap { padding: 12px 16px 16px; }
  .msg-body { max-width: 88%; }
  .chat-empty { margin-top: 20px; }
  .chat-empty__title { font-size: 1.4rem; }
  .chat-empty__grid { grid-template-columns: 1fr; }
  .page { padding: 20px; }
}

/* ---------- 12. Reduced motion ---------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition: none !important;
    animation: none !important;
  }
}

/* ============================================================
   Page patterns (used by Lab, Library, Settings, Admin)
   ============================================================ */

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100vh;
  overflow: hidden;
  background: var(--blush);
}

.page-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 32px;
}
.page-scroll::-webkit-scrollbar { width: 8px; }
.page-scroll::-webkit-scrollbar-thumb {
  background: rgba(17,16,74,0.12);
  border-radius: 4px;
}

.page-inner { 
  max-width: 1440px;
   margin: 0 auto; }

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}

.page-header__title {
  font-family: var(--font-head);
  font-size: 1.85rem;
  font-weight: 600;
  color: var(--navy);
  margin: 0 0 6px;
  line-height: 1.15;
  letter-spacing: -0.01em;
}

.page-header__sub {
  color: var(--slate);
  font-size: 0.95rem;
  margin: 0;
  max-width: 580px;
  line-height: 1.5;
}

.section {
  margin-bottom: 36px;
}
.section:last-child { margin-bottom: 0; }

.section__title {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--slate);
  margin: 0 0 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.section__title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
  opacity: 0.7;
}

/* Empty state block */
.empty-state {
  padding: 56px 32px;
  text-align: center;
  background: var(--white);
  border: 1px dashed var(--border);
  border-radius: var(--radius);
}
.empty-state__icon {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  background: var(--blush-deep);
  color: var(--navy);
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
  font-size: 1.4rem;
}
.empty-state__title {
  font-family: var(--font-head);
  font-size: 1.15rem;
  color: var(--navy);
  margin: 0 0 8px;
}
.empty-state__desc {
  color: var(--slate);
  font-size: 0.92rem;
  margin: 0 auto;
  max-width: 400px;
  line-height: 1.55;
}

/* Chip / filter pill */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--white);
  color: var(--slate);
  font-family: var(--font-body);
  font-size: 0.83rem;
  font-weight: 500;
  cursor: pointer;
  transition: background var(--transition), color var(--transition), border-color var(--transition);
}
.chip:hover {
  border-color: var(--navy);
  color: var(--navy);
}
.chip.is-active {
  background: var(--navy);
  color: var(--white);
  border-color: var(--navy);
}

@media (max-width: 860px) {
  .page-scroll { padding: 20px; }
  .page-header { margin-bottom: 24px; }
  .page-header__title { font-size: 1.5rem; }
  .section { margin-bottom: 28px; }
}

/* ============================================================
   Admin bar (injected on /admin/* pages)
   ============================================================ */

.admin-bar {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 14px;
  margin-bottom: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.admin-bar__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.admin-bar__back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 14px;
  border-radius: 999px;
  background: var(--blush);
  color: var(--navy);
  font-family: var(--font-body);
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;
  transition: background var(--transition), color var(--transition);
  border: 1px solid transparent;
}
.admin-bar__back:hover {
  background: var(--navy);
  color: var(--white);
  text-decoration: none;
}
.admin-bar__back i { font-size: 0.78rem; }

.admin-bar__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-ui);
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 500;
  color: var(--red);
  background: #FDECEC;
  padding: 5px 12px;
  border-radius: 999px;
}
.admin-bar__badge i { font-size: 0.7rem; }

.admin-bar__nav {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
  border-top: 1px solid var(--border-soft);
  padding-top: 10px;
}

.admin-bar__link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: 8px;
  font-family: var(--font-body);
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--slate);
  text-decoration: none;
  transition: background var(--transition), color var(--transition);
  white-space: nowrap;
}
.admin-bar__link:hover {
  background: var(--blush);
  color: var(--navy);
  text-decoration: none;
}
.admin-bar__link.is-active {
  background: var(--navy);
  color: var(--white);
}
.admin-bar__link i { font-size: 0.8rem; }

@media (max-width: 640px) {
  .admin-bar { padding: 10px; }
  .admin-bar__link { padding: 7px 10px; font-size: 0.8rem; }
  .admin-bar__link span { display: none; }
  .admin-bar__link i { font-size: 1rem; }
  .admin-bar__back span { display: inline; }
}
/* ============================================================
   Logo image + admin bar
   ============================================================ */

.sidebar__logo-slot img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  border-radius: 8px;
}
.sidebar__logo-slot.has-image {
  background: transparent;
  padding: 2px;
}

