// ============================================================
// ai/providers/openrouter.js
// ------------------------------------------------------------
// OpenRouter is our free-tier safety net. It supports many
// models; the "meta-llama/llama-3.3-70b-instruct:free" model
// supports function calling (tool use), which the platform
// needs for chat tool detection.
// ============================================================

module.exports = {
  id: 'openrouter',
  supportsTools: true,  // passes through to model
  baseUrl: 'https://openrouter.ai/api/v1',
  model: 'meta-llama/llama-3.3-70b-instruct:free',
  timeoutMs: 60000,
  keys: [process.env.OPENROUTER_KEY_1, process.env.OPENROUTER_KEY_2].filter(Boolean),
  extraHeaders: {
    'HTTP-Referer': 'https://tcsss-ai-learning-platform.onrender.com',
    'X-Title': 'TCSSS AI Learning Platform',
  },
};
